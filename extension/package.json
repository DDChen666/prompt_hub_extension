{
  "name": "prompt-organizer-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "zip": "cd dist && zip -r ../dist.zip . -q",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run tests/unit",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "guard": "node scripts/manifest-guard.mjs",
    "release:notes": "node -e \"console.log('# Release Notes\\n\\n- 新增：站點策略（Allow/Block/Copy-only）\\n- 新增：Feature Flags（Disable Overlay / Disable LLM / Readonly）\\n- 新增：一鍵匯出全部\\n- 修復：Overlay Toggle 更穩定')\" > RELEASE_NOTES.md",
    "release:sha": "shasum -a 256 dist.zip > dist.zip.sha256"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "webextension-polyfill": "^0.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.46.0",
    "@crxjs/vite-plugin": "^1.0.14",
    "jsdom": "^24.1.0",
    "@types/chrome": "^0.0.262",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "vitest": "^1.6.0"
  }
}
